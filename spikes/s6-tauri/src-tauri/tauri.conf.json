{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "viSHion-S6",
  "version": "0.1.0",
  "identifier": "app.vishion.s6",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "trunk serve --port 1420",
    "beforeBuildCommand": "node build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "viSHion S6", "width": 1000, "height": 800, "dragDropEnabled": true, "create": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
